# npm run setup creates a private .env with a random initial password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Used by Docker/Caddy. Point this domain's DNS to your server first.
SITE_HOST=geriapharm.example.com
# Development: http://localhost:5173 ; direct production: https://your-domain
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=data/geriapharm.sqlite
COOKIE_SECURE=false
PORT=3001
# Trust proxy headers only when a known reverse proxy connects over loopback.
TRUST_LOOPBACK_PROXY=false
